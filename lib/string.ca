import "string.h"
import "stdlib.h"
import "stdio.h"

data string
{
    point char val?
}
namespace string
    fn create(point char value?) -> string
    {
        string x?
        x.val = value
        return = x
    }
    fn set(string val?, point char value?) -> string
    {
        val.val = value
        return val
    }
    fn length(string val?) -> int
    {
        int ret?
        ret = strlen(val.val)
        return = ret
    }
    fn removeAt(string val?, int index?) -> string
    {
        int size = string.length(val)
        if size < index then return = val
        point char ret = malloc(sizeof(char) * (size - 1))
        int i = 0
        int j = 0
        while i < size
        {
            if i != index
            {
                ret[j] = val.val[i]
                j = j + 1
                
            }
            i = i + 1
        }
        string struct buf = string.create(ret)
        return = buf
    }
    fn pushChar(string val?, char c?) -> string
    {
        int size = string.length(val)
        point char ret = malloc(sizeof(char) * (size + 1))
        int i = 0
        while i < size
        {
            ret[i] = val.val[i]
            i = i + 1
        }
        ret[i] = c
        string struct buf = string.create(ret)
        return = buf
    }
    fn pushString(string val?, string add?) -> string
    {
        int size = string.length(add)
        int i = 0
        while i < size
        {
            val = string.pushChar(val, add.val[i])
            i = i + 1
        }
        return = val
    }
    fn removeFrom(string val?, int startInd?, int endInd?) -> string
    {
        int i = startInd
        while i < endInd
        {
            val = string.removeAt(val, i)
            i = i + 1
        }
        return = val
    }
endnamespace